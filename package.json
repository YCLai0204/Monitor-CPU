{
  "name": "monitor-cpu",
  "version": "1.0.0",
  "description": "工具列上的吉祥物（目前是螃蟹），CPU / GPU 負載越高跑得越快、顏色也越紅。",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/make-icon.js",
    "dist": "electron-builder --win portable",
    "dist:dir": "electron-builder --dir"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.local.monitorcpu",
    "productName": "Monitor-CPU",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "src/**/*",
      "!src/public/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/main/probe.ps1",
        "to": "probe.ps1"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ]
    }
  }
}
